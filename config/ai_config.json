{
  "strict_offline_mode": true,
  "device": "cuda",
  "base_model": {
    "model_name": "Qwen2.5-1.5B-Instruct",
    "local_path": "models/base_models/Qwen2.5-1.5B-Instruct",
    "license": "Apache-2.0"
  },
  "embedding_model": {
    "model_name": "all-MiniLM-L6-v2",
    "local_path": "models/embeddings/all-MiniLM-L6-v2",
    "dimension": 384
  },
  "training": {
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "learning_rate": 2e-4,
    "batch_size": 2,
    "gradient_accumulation_steps": 4,
    "max_seq_length": 768,
    "epochs": 3,
    "warmup_ratio": 0.05,
    "seed": 42
  },
  "retrieval": {
    "top_k": 3,
    "similarity_threshold": 0.35,
    "min_top_similarity_to_answer": 0.40,
    "index_path": "data/vector_index/faiss_index.bin",
    "passages_path": "data/vector_index/passages.json"
  },
  "adapter_output_dir": "models/local_research_llm/adapter_v1"
}
